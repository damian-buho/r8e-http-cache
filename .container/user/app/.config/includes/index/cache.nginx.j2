    proxy_cache proxy-cache;
    proxy_cache_key "$scheme$upstream_host$upstream_port$upstream_path$cache_qs$slice_range";
    slice {{ ENV.R8E_HTTP_CACHE_SLICE }};

    # Server-level valid replaces the http set, so it repeats every code.
    proxy_cache_valid 200 {{ ENV.O9S_NGINX_PROXY_CACHE_VALID_200 }};
    proxy_cache_valid 206 {{ ENV.O9S_NGINX_PROXY_CACHE_VALID_206 }};
    proxy_cache_valid 301 {{ ENV.O9S_NGINX_PROXY_CACHE_VALID_301 }};
    proxy_cache_valid 404 {{ ENV.O9S_NGINX_PROXY_CACHE_VALID_404 }};
    proxy_cache_valid any {{ ENV.O9S_NGINX_PROXY_CACHE_VALID_ANY }};

    add_header X-Cache-Status $upstream_cache_status always;

    # Server level so @redirect inherits it and chains multiple hops
    error_page 301 302 303 307 308 = @redirect;

    # ------------------------------------------------------------------
    location = / {
        return 400;
    }

    # ------------------------------------------------------------------
    location / {
        # Only cacheable methods are ever relayed upstream
        limit_except GET HEAD {
            deny all;
        }
        # Split the raw URI so encoding survives; rest keeps path and query as one
        set $upstream_host "";
        set $upstream_port "";
        set $upstream_path "";
        set $upstream_rest "";
        set $target "";

        if ($request_uri ~ "^/([^/?:]+)(:[0-9]+)?((/[^?]*)?(\?(.*))?)$") {
            set $upstream_host $1;
            set $upstream_port $2;
            set $upstream_rest $3;
            set $upstream_path $4;
        }

        # Fallback for shapes the split above rejects
        if ($upstream_host = "") {
            return 400;
        }

        # Reject userinfo smuggling via @ in the host segment
        if ($upstream_host ~ "@") {
            return 400;
        }

        # Reject trailing-dot FQDN tricks that dodge exact-match allowlists
        if ($upstream_host ~ "\.$") {
            return 400;
        }

        # Policy maps read the bare host without any port suffix
        set $check_host $upstream_host;

        # Literal interior targets never leave this box
        if ($upstream_blocked = 1) {
            return 403;
        }

        # Allowlist is default deny; widen it only via documented ENV override
        if ($upstream_allowed = 0) {
            return 403;
        }

        add_header X-Cache-Status $upstream_cache_status always;
        add_header X-Upstream-Host $upstream_host always;

        # Build target URL from raw parts so bytes survive untouched
        set $target "https://$upstream_host$upstream_port$upstream_rest";
        add_header X-Upstream-Target $target always;

        proxy_pass $target;
        proxy_set_header Host $upstream_host$upstream_port;
        proxy_set_header Range $slice_range;
        proxy_ssl_name $upstream_host;
        proxy_ssl_server_name on;
    }

    # ------------------------------------------------------------------
    location @redirect {
        internal;

        limit_except GET HEAD {
            deny all;
        }

        # One marker per hop; six in a row means a loop
        set $rh "${rh}x";
        if ($rh ~ "^xxxxxx$") {
            return 508;
        }

        set $new $upstream_http_location;
        if ($redirect_target = "") { return 502; }
        if ($redirect_host ~ "@") { return 502; }

        # Redirect targets clear the same policy as direct fetches
        set $check_host $redirect_host;
        if ($upstream_blocked = 1) {
            return 403;
        }
        if ($upstream_allowed = 0) {
            return 403;
        }

        # proxy_pass with a variable reuses the original URI on error_page entry.
        # The args assignment precedes the rewrite since break halts the phase.
        set $args $redirect_query;
        rewrite ^.*$ $redirect_path break;
        proxy_cache_key "$scheme$redirect_target$slice_range";
        proxy_pass https://$redirect_host$redirect_port;
        proxy_set_header Host $redirect_host$redirect_port;
        proxy_set_header Range $slice_range;
        proxy_ssl_name $redirect_host;
        proxy_ssl_server_name on;
        add_header X-Cache-Status $upstream_cache_status always;
        add_header X-Upstream-Redirect $new always;
    }
