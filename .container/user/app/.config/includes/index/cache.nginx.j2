    proxy_cache proxy-cache;
    proxy_cache_key "$scheme$upstream_host$request_uri";

    add_header X-Cache-Status $upstream_cache_status always;

    # ------------------------------------------------------------------
    location / {
        # Only cacheable methods are ever relayed upstream
        limit_except GET HEAD {
            deny all;
        }
        # Extract first path component as upstream domain
        set $upstream_host "";
        set $upstream_path "";
        set $target "";

        if ($uri ~ "^/([^/]+)(/.*)?$") {
            set $upstream_host $1;
            set $upstream_path $2;
        }

        if ($upstream_host = "") {
            return 400;
        }

        # Reject userinfo smuggling via @ in the host segment
        if ($upstream_host ~ "@") {
            return 400;
        }

        # Reject trailing-dot FQDN tricks that dodge exact-match allowlists
        if ($upstream_host ~ "\.$") {
            return 400;
        }

        # Literal interior targets never leave this box
        if ($upstream_blocked = 1) {
            return 403;
        }

        # Allowlist is default deny; widen it only via documented ENV override
        if ($upstream_allowed = 0) {
            return 403;
        }

        add_header X-Cache-Status $upstream_cache_status always;
        add_header X-Upstream-Host $upstream_host always;

        # Build target URL
        set $target "https://$upstream_host$upstream_path$is_args$args";
        add_header X-Upstream-Target $target always;

        proxy_pass $target;
        proxy_set_header Host $upstream_host;
        proxy_ssl_name $upstream_host;
        proxy_ssl_server_name on;

        # Redirects get handled internally instead of passed to clients
        error_page 301 302 303 307 308 = @redirect;
    }

    # ------------------------------------------------------------------
    location @redirect {
        internal;

        limit_except GET HEAD {
            deny all;
        }

        set $new $upstream_http_location;
        if ($new = "") { return 502; }

        proxy_pass $new;
        proxy_set_header Host $upstream_host;
        proxy_ssl_name $upstream_host;
        proxy_ssl_server_name on;
        add_header X-Cache-Status $upstream_cache_status always;
        add_header X-Upstream-Redirect $new always;
    }
