# Upstream allowlist for the cache index. Default deny: empty regex emits no rule.
# Both maps read $check_host, set to the bare direct or redirect host per location.
map $check_host $upstream_allowed {
    default 0;
{% if ENV.R8E_HTTP_CACHE_ALLOWLIST_REGEX is defined and ENV.R8E_HTTP_CACHE_ALLOWLIST_REGEX != "" %}
    "~*{{ ENV.R8E_HTTP_CACHE_ALLOWLIST_REGEX }}" 1;
{% endif %}
}

# Literal SSRF block as defense in depth behind the allowlist above.
map $check_host $upstream_blocked {
    default 0;
    "~*(^|\.)localhost$" 1;
    "~*^metadata\.google\.internal$" 1;
    "~^(127\.|10\.|172\.(1[6-9]|2[0-9]|3[0-1])\.|192\.168\.|169\.254\.|0\.)" 1;
    "~*^(::|\[|(fc|fd)[0-9a-f]*:|fe80:)" 1;
}

# Query normalizer for the cache key: all-junk queries collapse to empty.
map $args $cache_qs {
    default "?$args";
    "" "";
    "~^(utm_[^&]*|fbclid=[^&]*|gclid=[^&]*|msclkid=[^&]*|mc_[^&]*|igshid=[^&]*)(&(utm_[^&]*|fbclid=[^&]*|gclid=[^&]*|msclkid=[^&]*|mc_[^&]*|igshid=[^&]*))*$" "";
}
